  status        String                  @default("PENDING")
  headerText    String?
  bodyText      String
  footerText    String?
  buttons       Json?
  exampleValues Json?
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  messages WhatsAppMessage[]

  @@unique([accountId, name, language])
