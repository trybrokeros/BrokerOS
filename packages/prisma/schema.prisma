  isActive  Boolean         @default(true)
  isDefault Boolean         @default(false)

  // Encrypted Provider Credentials
  accountSid          String?
  authToken           String?
  messagingServiceSid String?
  apiKey              String?
  servicePlanId       String?
  awsAccessKeyId      String?
  awsSecretKey        String?
  awsRegion           String?
  dltEntityId         String?
  baseUrl             String?
  apiSecret           String?
