}

model BrokerDocument {
  id         String    @id @default(uuid())
  brokerId   String
  broker     Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  title      String
  type       String
  fileUrl    String
  fileType   String?
  isVerified Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([brokerId])
  @@map("broker_document")
}

model BrokerProjectAssignment {
  id               String   @id @default(uuid())
  brokerId         String
  broker           Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  towerId          String?
  isLocked         Boolean  @default(false)
  dealDocuments    String[]
  brokeragePercent Decimal?
  brokerageFlat    Decimal?
  closingManagerId String?
  assignedAt       DateTime @default(now())
  isActive         Boolean  @default(true)

  @@unique([brokerId, projectId])
  @@index([brokerId])
  @@index([projectId])
  @@map("broker_project_assignment")
}

model BrokerMeeting {
  id                String    @id @default(uuid())
  brokerId          String
  broker            Broker    @relation(fields: [brokerId], references: [id])
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  scheduledDate     DateTime
  actualDate        DateTime?
  meetingNotes      String?   @db.Text
  brokerInterest    String?
  projectsDiscussed String[]
  latitude          Float?
  longitude         Float?
  arriveLatitude    Float?
  arriveLongitude   Float?
  arrivedAt         DateTime?
  destinationUrl    String?
  selfieUrl         String?
  status            String    @default("SCHEDULED")
  nextMeetingDate   DateTime?
  nextFollowUpDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brokerId])
  @@index([userId])
  @@index([scheduledDate])
  @@map("broker_meeting")
}

// ─────────────────────────────────────────────
// NEW: TICKET-BASED APPROVAL SYSTEM
// ─────────────────────────────────────────────

model ApprovalRequest {
  id          String                @id @default(uuid())
  salesExecId String
  salesExec   User                  @relation("ApprovalRequestExec", fields: [salesExecId], references: [id])
  managerId   String
  manager     User                  @relation("ApprovalRequestManager", fields: [managerId], references: [id])
  status      ApprovalRequestStatus @default(REQUESTED)
  type        ApprovalType          @default(DISCOUNT)
  redoCount   Int                   @default(0)
  bookingId   String?
  booking     Booking?              @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ApprovalMessage[] @relation("RequestMessages")

  @@index([salesExecId])
  @@index([managerId])
  @@index([status])
  @@index([bookingId])
  @@map("approval_request")
}

model ApprovalMessage {
  id        String          @id @default(uuid())
  requestId String
  request   ApprovalRequest @relation("RequestMessages", fields: [requestId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User            @relation("ApprovalMessageSender", fields: [senderId], references: [id])

  title       String
  description String  @db.Text
  fileUrl     String? // URL for the uploaded file/blob
  metadata    Json? // Structured data for rich payloads (e.g. { documents: {name, url}[] })

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([senderId])
  @@map("approval_message")
}

model BrokerReferral {
  id                String    @id @default(uuid())
  brokerId          String
  broker            Broker    @relation(fields: [brokerId], references: [id])
  leadId            String?   @unique
  customerName      String
  customerPhone     String
  customerEmail     String?
  interestedProject String?
  closingManagerId  String?
  closingManager    User?     @relation("ReferralClosingManager", fields: [closingManagerId], references: [id])
  status            String    @default("REFERRED")
