}

model WhatsAppConversation {
  id           String                  @id @default(uuid())
  accountId    String
  account      WhatsAppBusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      WhatsAppContact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactPhone String
  contactName  String?

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  brokerId   String?
  broker     Broker?   @relation(fields: [brokerId], references: [id])

  agentUserId String?
  agent       User?   @relation("ConversationAgent", fields: [agentUserId], references: [id])

  status              String    @default("open")
  lastMessageText     String?   @db.Text
  lastMessageAt       DateTime?
  unreadCount         Int       @default(0)
  aiAutoReplyDisabled Boolean   @default(false)
  aiReplyCount        Int       @default(0)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  messages WhatsAppMessage[]
  flowRuns WhatsAppFlowRun[]
  deals    WhatsAppDeal[]

  @@index([accountId])
  @@index([contactId])
  @@index([status])
  @@index([leadId])
  @@index([customerId])
  @@index([brokerId])
  @@index([contactPhone])
  @@index([lastMessageAt])
  @@map("whatsapp_conversation")
}

model WhatsAppMessage {
  id             String               @id @default(uuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  waMessageId String?                  @unique
  direction   WhatsAppMessageDirection
  type        WhatsAppMessageType
  status      WhatsAppMessageStatus
  senderType  String                   @default("agent")
  contentType String                   @default("text")
  senderName  String?

  body               String?           @db.Text
  caption            String?
  templateId         String?
  template           WhatsAppTemplate? @relation(fields: [templateId], references: [id])
  templateValues     Json?
  interactivePayload Json?

  mediaUrl  String?
  mediaType String?
  mediaSize Int?
  fileName  String?

  replyToMessageId String?
  replyTo          WhatsAppMessage?  @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          WhatsAppMessage[] @relation("MessageReplies")

  isAiGenerated Boolean @default(false)

  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([waMessageId])
  @@index([direction])
  @@index([status])
  @@index([senderType])
  @@index([contentType])
  @@index([createdAt])
  @@map("whatsapp_message")
}

