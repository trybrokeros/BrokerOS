}

model EmailTemplate {
  id              String  @id @default(uuid())
  name            String
  subject         String
  category        String // "PROJECT_LAUNCH", "PRICE_DROP", "FESTIVE", "CP_COMMISSION", "NEWSLETTER"
  htmlBody        String  @db.Text
  plainText       String? @db.Text
  previewImageUrl String?
  isSystem        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns MarketingCampaign[]

  @@index([category])
  @@map("email_template")
}

model MarketingCampaign {
  id             String             @id @default(uuid())
  title          String
  channel        MarketingChannel   @default(EMAIL)
  status         CampaignStatus     @default(DRAFT)
  providerType   EmailProviderType  @default(SYSTEM_DEFAULT)
  audienceSource AudienceSourceType @default(CRM_DATABASE)

  // Scope: Brokerage vs Channel Partner
  isCpCampaign   Boolean  @default(false)
  allocationMode String   @default("AUTO_EVEN")
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])

  integrationId String?
  integration   MarketingIntegration? @relation(fields: [integrationId], references: [id])

  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id])

  subject     String
  fromName    String
  fromEmail   String
  replyTo     String?
  htmlContent String  @db.Text

  // Dynamic filter JSON (e.g. { temperatures: ["HOT"], statuses: ["INTERESTED"], minBudget: 5000000 })
  audienceFilters Json?

  // Aggregate Performance Metrics
  totalRecipients   Int @default(0)
  sentCount         Int @default(0)
  deliveredCount    Int @default(0)
  openedCount       Int @default(0)
  clickedCount      Int @default(0)
  bouncedCount      Int @default(0)
  complaintCount    Int @default(0)
  unsubscribedCount Int @default(0)

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdById String?
  createdBy   User?   @relation("CampaignCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients     CampaignRecipient[]
  senderPools    CampaignSenderPool[]
  trackingEvents EmailTrackingEvent[]
  emailConversations EmailConversation[]

  @@index([status])
  @@index([channel])
  @@index([projectId])
  @@index([integrationId])
  @@index([createdAt])
  @@map("marketing_campaign")
}

model CampaignSenderPool {
  id         String            @id @default(uuid())
  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  senderDomainId String?
  senderDomain   MarketingSenderDomain? @relation(fields: [senderDomainId], references: [id], onDelete: SetNull)

  domain    String?
  fromEmail String?
  fromName  String?
  provider  String?

  weight              Int    @default(1)
  allocatedRecipients Int    @default(0)
  sentCount           Int    @default(0)
  deliveredCount      Int    @default(0)
  failedCount         Int    @default(0)
  status              String @default("QUEUED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients CampaignRecipient[]

  @@index([campaignId, senderDomainId])
  @@index([campaignId, status])
  @@map("campaign_sender_pool")
}

model CampaignRecipient {
  id         String            @id @default(uuid())
  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  senderPoolId        String?
  senderPool          CampaignSenderPool? @relation(fields: [senderPoolId], references: [id], onDelete: SetNull)
  assignedSenderEmail String?
  assignedProvider    String?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  brokerId String?
  broker   Broker? @relation(fields: [brokerId], references: [id])

  email         String
  name          String?
  phone         String?
  status        RecipientDeliveryStatus @default(QUEUED)
  source        AudienceSourceType      @default(CRM_DATABASE)
  providerMsgId String?

  sentAt         DateTime?
  deliveredAt    DateTime?
  firstOpenedAt  DateTime?
  openCount      Int       @default(0)
  firstClickedAt DateTime?
  clickCount     Int       @default(0)
  bouncedAt      DateTime?
  bounceReason   String?
  mergeData      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, status])
  @@index([senderPoolId])
  @@index([email])
  @@index([leadId])
  @@map("campaign_recipient")
}

model EmailTrackingEvent {
  id          String            @id @default(uuid())
  campaignId  String
  campaign    MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId String

  eventType  String // "OPEN", "CLICK", "BOUNCE", "UNSUBSCRIBE"
  urlClicked String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([campaignId, eventType])
  @@index([recipientId])
  @@map("email_tracking_event")
}

model MarketingUnsubscribe {
  id         String           @id @default(uuid())
  email      String           @unique
  reason     String?
  campaignId String?
  channel    MarketingChannel @default(EMAIL)
  createdAt  DateTime         @default(now())

  @@map("marketing_unsubscribe")
}

// ─────────────────────────────────────────────
// 14b. EMAIL FLOWS, INBOUND REPLIES & AI CONCIERGE
// ─────────────────────────────────────────────

model EmailFlow {
  id            String          @id @default(uuid())
  name          String
  description   String?
  status        String          @default("draft") // "draft" | "active" | "archived"
  triggerType   String          @default("keyword_match") // "keyword_match" | "any_reply" | "campaign_reply"
  triggerConfig Json?           // { keywords: ["visit", "price"], matchMode: "contains" | "exact" }
  isGlobal      Boolean         @default(true)
  campaignIds   String[]        // Array of specific campaign IDs if not global
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  nodes         EmailFlowNode[]
  runs          EmailFlowRun[]

  @@index([status])
  @@index([projectId])
  @@map("email_flow")
}

model EmailFlowNode {
  id        String    @id @default(uuid())
  flowId    String
  flow      EmailFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  nodeKey   String
  nodeType  String    // "start" | "send_email_reply" | "ai_agent" | "update_lead_status" | "add_tag" | "remove_tag" | "handoff_presales" | "condition" | "wait_delay" | "end"
  config    Json
  positionX Float?
  positionY Float?
  createdAt DateTime  @default(now())

  @@unique([flowId, nodeKey])
  @@index([flowId])
  @@map("email_flow_node")
}

model EmailFlowRun {
  id             String    @id @default(uuid())
  flowId         String
  flow           EmailFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  recipientId    String?
  campaignId     String?
  leadId         String?
  status         String    @default("active") // "active" | "completed" | "failed"
  currentNodeKey String?
  inboundSubject String?
  inboundBody    String?   @db.Text
  outboundReply  String?   @db.Text
  vars           Json?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  @@index([flowId])
  @@index([recipientId])
  @@index([campaignId])
  @@index([status])
  @@map("email_flow_run")
}

model EmailTag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#8B5CF6")
  createdAt DateTime @default(now())

  @@map("email_tag")
}

model EmailInboundMessage {
  id                 String   @id @default(uuid())
  fromEmail          String
  toEmail            String
  subject            String?
  textBody           String?  @db.Text
  htmlBody           String?  @db.Text
  headers            Json?
  provider           String   // "SENDGRID" | "AWS_SES" | "BREVO" | "MAILCHIMP" | "UNIVERSAL"
  providerMsgId      String?
  inReplyTo          String?
  matchedRecipientId String?
  matchedCampaignId  String?
  matchedLeadId      String?
  status             String   @default("PROCESSED") // "RECEIVED" | "PROCESSED" | "UNMATCHED"
  createdAt          DateTime @default(now())

  @@index([fromEmail])
  @@index([toEmail])
  @@index([matchedRecipientId])
  @@index([matchedCampaignId])
  @@map("email_inbound_message")
}

model EmailConversation {
  id                  String    @id @default(uuid())
  contactEmail        String
  contactName         String?
  subject             String?

  leadId              String?
  lead                Lead?     @relation(fields: [leadId], references: [id])
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id])
  brokerId            String?
  broker              Broker?   @relation(fields: [brokerId], references: [id])

  agentUserId         String?
  agent               User?     @relation("EmailConversationAgent", fields: [agentUserId], references: [id])

  status              String    @default("open") // "open" | "pending" | "closed"
  lastMessageText     String?   @db.Text
  lastMessageAt       DateTime?
  unreadCount         Int       @default(0)
  aiAutoReplyDisabled Boolean   @default(false)
  aiReplyCount        Int       @default(0)

  // Dedicated Provider & Domain thread continuity
  assignedProvider    String    @default("SYSTEM_DEFAULT") // "SENDGRID" | "AWS_SES" | "BREVO" | "MAILCHIMP" | "SYSTEM_DEFAULT"
  assignedSenderEmail String?   // e.g. "deals@skyline-towers.ae"
  assignedSenderName  String?   // e.g. "Skyline Sales Team"
  campaignId          String?
  campaign            MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipientId         String?

  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  messages            EmailMessage[]

  @@index([contactEmail])
  @@index([status])
  @@index([leadId])
  @@index([customerId])
  @@index([brokerId])
  @@index([agentUserId])
  @@index([lastMessageAt])
  @@map("email_conversation")
}

model EmailMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   EmailConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction      String            // "INBOUND" | "OUTBOUND"
  senderType     String            @default("agent") // "agent" | "bot" | "contact"
  senderName     String?
  fromEmail      String
  toEmail        String
  subject        String?
  bodyText       String?           @db.Text
  bodyHtml       String?           @db.Text

  status         String            @default("SENT") // "PENDING" | "SENT" | "DELIVERED" | "OPENED" | "CLICKED" | "FAILED"
  provider       String?           // "SENDGRID" | "AWS_SES" | "BREVO" | "MAILCHIMP" | "SIMULATOR"
  providerMsgId  String?           @unique
  inReplyTo      String?

  attachments    Json?             // Array of { name: string, url: string, size?: number, contentType?: string }
  isAiGenerated  Boolean           @default(false)

  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  failedAt       DateTime?
  failureReason  String?

  createdAt      DateTime          @default(now())

  @@index([conversationId])
  @@index([direction])
  @@index([status])
  @@index([providerMsgId])
  @@index([createdAt])
  @@map("email_message")
}

model EmailAiConfig {
