}

model SiteVisitVerification {
  id                  String    @id @default(uuid())
  siteVisitId         String    @unique
  siteVisit           SiteVisit @relation(fields: [siteVisitId], references: [id], onDelete: Cascade)
  latitude            Float
  longitude           Float
  locationAccuracy    Float?
  locationAddress     String?
  siteVisitSelfieUrl  String
  customerSelfieUrl   String?
  additionalPhotoUrls String[]
  gpsTrackingData     Json?
  verifiedAt          DateTime  @default(now())

  @@map("site_visit_verification")
}

model Negotiation {
  id          String  @id @default(uuid())
  leadId      String
  lead        Lead    @relation(fields: [leadId], references: [id])
  unitId      String?
  unit        Unit?   @relation(fields: [unitId], references: [id])
  salesExecId String
  salesExec   User    @relation(fields: [salesExecId], references: [id])

  askingPrice       Decimal?
  offeredPrice      Decimal?
  counterPrice      Decimal?
  finalPrice        Decimal?
  discountRequested Decimal?
  discountType      String?
  discountApproved  Decimal?

  customerObjections String? @db.Text
  managerSuggestion  String? @db.Text
  negotiationNotes   String? @db.Text
  nextActionPlan     String? @db.Text

  status          NegotiationStatus @default(OPEN)
  approvedById    String?
  approvalRemarks String?
  approvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([leadId])
  @@index([unitId])
  @@index([salesExecId])
  @@index([status])
  @@map("negotiation")
}

// NOTE: BookingRequest model removed.
// Sales Exec creates Booking directly. Discounts go through FinancialApproval.

// ─────────────────────────────────────────────
// 8. DOMAIN 6: BOOKING & POST-SALES
// ─────────────────────────────────────────────

model Customer {
  id               String    @id @default(uuid())
  leadId           String    @unique
  lead             Lead      @relation(fields: [leadId], references: [id])
  firstName        String
  lastName         String?
  phone            String
  alternatePhone   String?
  email            String?
  aadhaarNumber    String?
  panNumber        String?
  dateOfBirth      DateTime?
  currentAddress   String?   @db.Text
  permanentAddress String?   @db.Text
  city             String?
  state            String?
  pincode          String?
  occupation       String?
  companyName      String?
  annualIncome     Decimal?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  bookings              Booking[]
  documents             CustomerDocument[]
  followUps             FollowUp[]
  notes                 Note[]                 @relation("CustomerNotes")
  activities            ActivityTimeline[]     @relation("CustomerActivities")
  whatsappConversations WhatsAppConversation[]
  emailConversations    EmailConversation[]
  smsConversations      SmsConversation[]

  @@index([phone])
  @@index([leadId])
  @@map("customer")
}

model Booking {
  id                  String        @id @default(uuid())
  bookingNumber       String        @unique
  customerId          String
  customer            Customer      @relation(fields: [customerId], references: [id])
  unitId              String
  unit                Unit          @relation(fields: [unitId], references: [id])
  source              BookingSource
  salesExecId         String?
  salesExec           User?         @relation("BookingSalesExec", fields: [salesExecId], references: [id])
  closingManagerId    String?
  closingManager      User?         @relation("BookingClosingManager", fields: [closingManagerId], references: [id])
  assignedPostSalesId String?
  assignedPostSales   User?         @relation("BookingPostSales", fields: [assignedPostSalesId], references: [id])
  negotiationId       String?
  negotiation         Negotiation?  @relation(fields: [negotiationId], references: [id])

  agreedPrice          Decimal
  tokenAmount          Decimal?
  discountAmount       Decimal?
  gstAmount            Decimal?
  stampDutyAmount      Decimal?
  registrationAmount   Decimal?
  totalPayable         Decimal
  commissionPercentage Decimal?
  commissionAmount     Decimal?

  status         BookingStatus @default(CONFIRMED)
  bookingDate    DateTime      @default(now())
  agreementDate  DateTime?
  possessionDate DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  refundAmount   Decimal?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  documents          CustomerDocument[]
  paymentSchedules   PaymentSchedule[]
  loanCase           LoanCase?
  agreement          Agreement?
  possession         PossessionHandover?
  brokerageRecords   BrokerageRecord[]
  collectionRecords  CollectionRecord[]
  notes              Note[]              @relation("BookingNotes")
  inboundCommissions InboundCommission[]

  invoices         Invoice[]
  approvalRequests ApprovalRequest[]

  @@index([customerId])
  @@index([unitId])
  @@index([status])
  @@index([bookingDate])
  @@index([source])
  @@map("booking")
}

model CustomerDocument {
  id                 String                     @id @default(uuid())
  customerId         String
  customer           Customer                   @relation(fields: [customerId], references: [id])
  bookingId          String?
  booking            Booking?                   @relation(fields: [bookingId], references: [id])
  type               DocumentType
  title              String
  description        String?                    @db.Text
  fileUrl            String
  fileType           String?
  fileSize           Int?
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedBy         User?                      @relation(fields: [verifiedById], references: [id])
  verifiedAt         DateTime?
  rejectionReason    String?
  expiryDate         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([bookingId])
  @@index([type])
  @@index([verificationStatus])
  @@map("customer_document")
}

model PaymentSchedule {
  id              String        @id @default(uuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  milestoneName   String
  sequenceOrder   Int
  amount          Decimal
  dueDate         DateTime
  status          PaymentStatus @default(PENDING)
  paidAmount      Decimal       @default(0)
  remainingAmount Decimal
  lastPaymentDate DateTime?
  overdueBy       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions PaymentTransaction[]

  @@index([bookingId])
  @@index([dueDate])
  @@index([status])
  @@map("payment_schedule")
}

model PaymentTransaction {
  id                String          @id @default(uuid())
  paymentScheduleId String
  paymentSchedule   PaymentSchedule @relation(fields: [paymentScheduleId], references: [id], onDelete: Cascade)
  amount            Decimal
  paymentMode       PaymentMode
  paymentDate       DateTime
  referenceNumber   String?
  receiptNumber     String?         @unique
  receiptUrl        String?
  bankName          String?
  bankBranch        String?
  remarks           String?
  recordedById      String
  recordedBy        User            @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([paymentScheduleId])
  @@index([paymentDate])
  @@map("payment_transaction")
}

model LoanCase {
  id                    String     @id @default(uuid())
  bookingId             String     @unique
  booking               Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  loanApplicationNumber String?
  dsaName               String?
  dsaContact            String?
  bankName              String?
  bankBranch            String?
  bankContactPerson     String?
  bankContactPhone      String?
  loanAmount            Decimal?
  approvedAmount        Decimal?
  interestRate          Decimal?
  tenure                Int?
  emiAmount             Decimal?
  status                LoanStatus @default(NOT_APPLIED)
  applicationDate       DateTime?
  approvalDate          DateTime?
  disbursementDate      DateTime?
  rejectionDate         DateTime?
  rejectionReason       String?
  loanDocumentUrls      String[]
  sanctionLetterUrl     String?
  pendingActions        String?    @db.Text
  internalNotes         String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loan_case")
}

model Agreement {
  id                 String          @id @default(uuid())
  bookingId          String          @unique
  booking            Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status             AgreementStatus @default(NOT_STARTED)
  agreementNumber    String?
  subRegistrarOffice String?
  appointmentTime    DateTime?
  draftDate          DateTime?
  stampDutyDate      DateTime?
  registrationDate   DateTime?
  completionDate     DateTime?
  stampDutyAmount    Decimal?
  registrationFee    Decimal?
  stampDutyPaid      Boolean         @default(false)
  registrationDone   Boolean         @default(false)
  draftDocumentUrl   String?
  finalDocumentUrl   String?
  lawyerName         String?
  lawyerContact      String?
  remarks            String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agreement")
}

model PossessionHandover {
  id                     String           @id @default(uuid())
  bookingId              String           @unique
  booking                Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status                 PossessionStatus @default(NOT_READY)
  expectedDate           DateTime?
  scheduledDate          DateTime?
  actualDate             DateTime?
  handoverNotes          String?          @db.Text
  electricityMeterNumber String?
  waterMeterNumber       String?
  parkingSlotNumber      String?
  snagList               Json?
  snagResolved           Boolean          @default(false)
  occupancyCertUrl       String?
  completionCertUrl      String?
  handoverDocUrl         String?
  keysHandedOver         Boolean          @default(false)
  keyHandoverDate        DateTime?
  handoverById           String?
  handoverBy             User?            @relation(fields: [handoverById], references: [id])
  customerFeedback       String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("possession_handover")
}

// ─────────────────────────────────────────────
// 9. DOMAIN 7: CHANNEL PARTNER & BROKERAGE
