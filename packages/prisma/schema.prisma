model Builder {
  id            String   @id @default(uuid())
  name          String
  companyName   String?
  reraNumber    String?
  contactPerson String?
  phone         String?
  email         String?
  address       String?  @db.Text
  website       String?
  logoUrl       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]

  @@map("builder")
}

model Project {
  id                 String              @id @default(uuid())
  name               String
  slug               String?             @unique
  isCpProject        Boolean             @default(false)
  builderId          String
  builder            Builder             @relation(fields: [builderId], references: [id])
  type               ProjectType
  status             ProjectStatus       @default(UPCOMING)
  constructionStatus ConstructionStatus?
  possessionTimeline Json?
  reraNumber         String?
  description        String?             @db.Text

  address       String? @db.Text
  city          String?
  state         String?
  pincode       String?
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?

  amenities   String[]
  totalTowers Int?
  totalUnits  Int?
  totalFloors Int?

  thumbnailUrl String?
  brochureUrl  String?
  isVisible    Boolean @default(true)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  towers               Tower[]
  priceSheets          PriceSheet[]
  floorPlans           FloorPlan[]
  paymentPlanTemplates PaymentPlanTemplate[]
  offers               Offer[]
  constructionUpdates  ConstructionUpdate[]
  projectDocuments     ProjectDocument[]
  projectAssignments   ProjectAssignment[]
  leads                Lead[]
  siteVisits           SiteVisit[]
  distributionRules    LeadDistributionRule[]
  brokerAssignments    BrokerProjectAssignment[]
  inboundCommissions   InboundCommission[]
  campaigns            MarketingCampaign[]
  smsCampaigns         SmsCampaign[]
  voiceCampaigns       VoiceCampaign[]
  emailFlows           EmailFlow[]
  smsFlows             SmsFlow[]

  @@index([builderId])
  @@index([status])
  @@index([type])
  @@index([city])
  @@map("project")
}

model Tower {
  id                 String              @id @default(uuid())
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  totalFloors        Int?
  totalUnits         Int?
  constructionStatus ConstructionStatus?
  possessionTimeline Json?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  floors           Floor[]
  projectDocuments ProjectDocument[]
  towerAssignments TowerAssignment[]
  leads            Lead[]

  @@index([projectId])
  @@map("tower")
}

model TowerAssignment {
  id      String @id @default(uuid())
  towerId String
  tower   Tower  @relation(fields: [towerId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([towerId, userId])
  @@index([towerId])
  @@index([userId])
  @@map("tower_assignment")
}

model Floor {
  id          String   @id @default(uuid())
  towerId     String
  tower       Tower    @relation(fields: [towerId], references: [id], onDelete: Cascade)
  floorNumber Int
  name        String?
  totalUnits  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units Unit[]

  @@unique([towerId, floorNumber])
  @@index([towerId])
  @@map("floor")
}

model Unit {
  id                   String              @id @default(uuid())
  floorId              String
  floor                Floor               @relation(fields: [floorId], references: [id], onDelete: Cascade)
  unitNumber           String
  type                 UnitType
  status               UnitStatus          @default(AVAILABLE)
  carpetArea           Decimal?
  builtUpArea          Decimal?
  superBuiltUpArea     Decimal?
  basePrice            Decimal?
  pricePerSqFt         Decimal?
  totalPrice           Decimal?
  commissionPercentage Decimal?
  commissionAmount     Decimal?
  facing               String?
  balconies            Int?                @default(0)
  parkingIncluded      Boolean             @default(false)
  floorPlanUrl         String?
  remarks              String?
  constructionStatus   ConstructionStatus?
  possessionTimeline   Json?

  blockedAt     DateTime?
  blockedById   String?
  blockedBy     User?     @relation("UnitBlockedBy", fields: [blockedById], references: [id])
  reservedAt    DateTime?
  reservedForId String?
  reservedFor   User?     @relation("UnitReservedFor", fields: [reservedForId], references: [id])
  soldAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negotiations       Negotiation[]
  bookings           Booking[]
  unitHistory        UnitStatusHistory[]
  leads              Lead[]
  inboundCommissions InboundCommission[]

  @@unique([floorId, unitNumber])
  @@index([floorId])
  @@index([status])
  @@index([type])
  @@map("unit")
}

model UnitStatusHistory {
  id          String     @id @default(uuid())
  unitId      String
  unit        Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  fromStatus  UnitStatus
  toStatus    UnitStatus
  changedById String
  reason      String?
  changedAt   DateTime   @default(now())

  @@index([unitId])
  @@index([changedAt])
  @@map("unit_status_history")
}

model PriceSheet {
  id            String    @id @default(uuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  priceData     Json
  documentUrl   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId])
  @@index([isActive])
  @@map("price_sheet")
}

model FloorPlan {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitType  UnitType?
  title     String
  fileUrl   String
  fileType  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId])
  @@map("floor_plan")
}

model PaymentPlanTemplate {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestones PaymentPlanMilestone[]

  @@index([projectId])
  @@map("payment_plan_template")
}

model PaymentPlanMilestone {
  id             String              @id @default(uuid())
  templateId     String
  template       PaymentPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name           String
  percentage     Decimal
  dueDescription String?
  sequenceOrder  Int
  createdAt      DateTime            @default(now())

  @@index([templateId])
  @@map("payment_plan_milestone")
}

model Offer {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?  @db.Text
  discountType  String?
  discountValue Decimal?
  validFrom     DateTime
  validTo       DateTime
  terms         String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([validFrom, validTo])
  @@map("offer")
}

model ConstructionUpdate {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?  @db.Text
  stage           String?
  progressPercent Int?
  imageUrls       String[]
  updatedById     String
  updatedBy       User     @relation(fields: [updatedById], references: [id])
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([publishedAt])
  @@map("construction_update")
}

model ProjectDocument {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  towerId   String?
  tower     Tower?   @relation(fields: [towerId], references: [id], onDelete: Cascade)
  title     String
  category  String
  fileUrl   String
  fileType  String?
  fileSize  Int?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([towerId])
  @@index([category])
  @@map("project_document")
}

model ProjectAssignment {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String?
  assignedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_assignment")
}

// ─────────────────────────────────────────────
// 7. DOMAIN 5: SITE VISIT & SALES PIPELINE
// ─────────────────────────────────────────────

model SiteVisit {
  id          String  @id @default(uuid())
  leadId      String
  lead        Lead    @relation(fields: [leadId], references: [id])
  projectId   String
  project     Project @relation(fields: [projectId], references: [id])
  salesExecId String
  salesExec   User    @relation("SalesExec", fields: [salesExecId], references: [id])
  createdById String
  createdBy   User    @relation("SiteVisitCreator", fields: [createdById], references: [id])

  scheduledDate      DateTime
  scheduledTime      DateTime?
  actualDate         DateTime?
  arrivedAt          DateTime?
  arriveLatitude     Float?
  arriveLongitude    Float?
  arriveNotifSentAt  DateTime?
  destinationUrl     String?
  status             SiteVisitStatus        @default(ASSIGNED)
  interestLevel      CustomerInterestLevel?
  meetingNotes       String?                @db.Text
  budgetConfirmed    Decimal?
  configInterest     String?
  customerReaction   String?
  customerObjections String?                @db.Text
  closingProbability String?
  completedAt        DateTime?
  nextAction         String?
  nextFollowUpDate   DateTime?
  cancelReason       String?
  rescheduledFrom    DateTime?

