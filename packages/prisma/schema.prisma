  accountId         String
  account           WhatsAppBusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pipelineId        String
  pipeline          WhatsAppPipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId           String
  stage             WhatsAppPipelineStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contactId         String
  contact           WhatsAppContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId    String?
  conversation      WhatsAppConversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
