  systemPrompt        String?  @db.Text
  isActive            Boolean  @default(true)
  autoReplyEnabled    Boolean  @default(false)
  autoReplyMaxPerLead Int      @default(3)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("email_ai_config")
}

