// ─────────────────────────────────────────────
// 3. DOMAIN 1: IDENTITY & ACCESS
// ─────────────────────────────────────────────

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  roles     Role[]
  chatRooms ChatRoom[]

  distributionRules LeadDistributionRule[]

  @@map("department")
}

model User {
  id              String     @id @default(uuid())
  name            String?
  email           String?    @unique
  emailVerified   Boolean    @default(false)
  image           String?
  username        String?    @unique
  displayUsername String?
  phoneNumber     String?    @unique
  employeeCode    String?    @unique
  status          UserStatus @default(ACTIVE)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  roleId       String?
  role         Role?       @relation(fields: [roleId], references: [id])
  managerId    String?
  manager      User?       @relation("UserManager", fields: [managerId], references: [id])
  subordinates User[]      @relation("UserManager")

  lastLatitude   Float?
  lastLongitude  Float?
  lastLocationAt DateTime?

  expoPushToken String?

  isOnCall Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions Session[]
  accounts Account[]

  loginHistory             LoginHistory[]
  assignedLeads            Lead[]                  @relation("AssignedUser")
  createdLeads             Lead[]                  @relation("CreatedBy")
  followUps                FollowUp[]
  callRecords              CallRecord[]
  siteVisitsAsExec         SiteVisit[]             @relation("SalesExec")
  siteVisitsAsCreator      SiteVisit[]             @relation("SiteVisitCreator")
  negotiations             Negotiation[]
  tasks                    Task[]                  @relation("AssignedTo")
  createdTasks             Task[]                  @relation("TaskCreator")
  notifications            Notification[]
  notes                    Note[]
  targets                  EmployeeTarget[]
  recognitions             EmployeeRecognition[]
  attendance               Attendance[]
  dailyPerformanceLogs     DailyPerformanceLog[]
  auditLogs                AuditLog[]
  projectAssignments       ProjectAssignment[]
  towerAssignments         TowerAssignment[]
  chatRoomMembers          ChatRoomMember[]
  chatMessages             ChatMessage[]
  whatsappConversations    WhatsAppConversation[]  @relation("ConversationAgent")
  emailConversations       EmailConversation[]     @relation("EmailConversationAgent")
  smsConversations         SmsConversation[]       @relation("SmsConversationAgent")
  brokerMeetings           BrokerMeeting[]
  managedBrokers           Broker[]                @relation("SourcingManager")
  assignmentFrom           LeadAssignmentHistory[] @relation("AssignmentFrom")
  assignmentTo             LeadAssignmentHistory[] @relation("AssignmentTo")
  assignedByUser           LeadAssignmentHistory[] @relation("AssignedByUser")
  blockedUnits             Unit[]                  @relation("UnitBlockedBy")
  reservedUnits            Unit[]                  @relation("UnitReservedFor")
  constructionUpdates      ConstructionUpdate[]
  verifiedDocuments        CustomerDocument[]
  salesExecBookings        Booking[]               @relation("BookingSalesExec")
  closedBookings           Booking[]               @relation("BookingClosingManager")
  paymentTransactions      PaymentTransaction[]
  possessionHandovers      PossessionHandover[]
  closedReferrals          BrokerReferral[]        @relation("ReferralClosingManager")
  approvedBrokerageRecords BrokerageRecord[]       @relation("BrokerageRecordApprover")
  assignedCollections      CollectionRecord[]      @relation("CollectionAssignedTo")
  approvedSettlements      BrokerageSettlement[]   @relation("SettlementApprover")
  processedSettlements     BrokerageSettlement[]   @relation("SettlementProcessor")
  requestedExpenses        Expense[]               @relation("ExpenseRequester")
  approvedExpenses         Expense[]               @relation("ExpenseApprover")
  createdInvoices          Invoice[]
  requestedApprovals       FinancialApproval[]     @relation("ApprovalRequester")
  level1Approvals          FinancialApproval[]     @relation("ApprovalLevel1")
  level2Approvals          FinancialApproval[]     @relation("ApprovalLevel2")
  managerTasks             ManagerTask[]           @relation("ManagerTaskCreator")
  taskAssignments          ManagerTaskUser[]       @relation("ManagerTaskAssignee")
  createdAnnouncements     Announcement[]          @relation("AnnouncementCreator")

  approvalRequestsMade       ApprovalRequest[]      @relation("ApprovalRequestExec")
  approvalRequestsManaged    ApprovalRequest[]      @relation("ApprovalRequestManager")
  approvalMessagesSent       ApprovalMessage[]      @relation("ApprovalMessageSender")
  receivedInboundCommissions InboundCommission[]    @relation("ReceivedInboundCommissions")
  assignedPostSalesBookings  Booking[]              @relation("BookingPostSales")
  createdCampaigns           MarketingCampaign[]    @relation("CampaignCreatedBy")
  createdSmsCampaigns        SmsCampaign[]          @relation("SmsCampaignCreatedBy")
  createdVoiceCampaigns      VoiceCampaign[]        @relation("VoiceCampaignCreatedBy")
  createdWhatsAppBroadcasts  WhatsAppBroadcast[]    @relation("WhatsAppBroadcastCreatedBy")
  createdWhatsAppAutomations WhatsAppAutomation[]   @relation("WhatsAppAutomationCreatedBy")
  assignedWhatsAppDeals      WhatsAppDeal[]         @relation("WhatsAppDealAssignedUser")
  createdWhatsAppNotes       WhatsAppContactNote[]  @relation("WhatsAppNoteAuthor")
  dealActivities             WhatsAppDealActivity[] @relation("WhatsAppDealActivityAuthor")

  @@index([departmentId])
  @@index([roleId])
  @@index([managerId])
  @@index([status])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Role {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique
  description  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  isSystemRole Boolean     @default(false)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  permissions RolePermission[]
  users       User[]

  @@index([departmentId])
  @@map("role")
}

model RolePermission {
  id        String           @id @default(uuid())
  roleId    String
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource  String
  action    PermissionAction
  isAllowed Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([roleId, resource, action])
  @@index([roleId])
  @@map("role_permission")
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  action      AuditAction
  entityType  String
  entityId    String
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  description String?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model LoginHistory {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  device    String?
  browser   String?
  os        String?
  loginAt   DateTime  @default(now())
  logoutAt  DateTime?
  isSuccess Boolean   @default(true)

  @@index([userId])
  @@index([loginAt])
  @@map("login_history")
}

model EmployeeTarget {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period           String
  targetCalls      Int?
  targetFollowUps  Int?
  targetSiteVisits Int?
  targetBookings   Int?
  targetRevenue    Decimal?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, period])
  @@index([userId])
  @@map("employee_target")
}

model EmployeeRecognition {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  awardType   String
  period      String
  metric      String?
  metricValue Decimal?
  awardedAt   DateTime @default(now())

  @@index([userId])
  @@index([awardType])
  @@map("employee_recognition")
}

model Attendance {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  status    String    @default("PRESENT")
  remarks   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("attendance")
}

model DailyPerformanceLog {
  id     String   @id @default(uuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  // Cold Call tracking
  coldCallTarget         Int @default(100)
  coldCallsDone          Int @default(0)
  coldCallBacklogIn      Int @default(0) // backlog carried into this day
  coldCallBacklogCleared Int @default(0) // how many backlog calls cleared this day

  // Follow-up tracking
  followUpTarget    Int   @default(0)
  followUpsDone     Int   @default(0)
  missedFollowUpIds Json? // array of follow-up IDs that were missed this day

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("daily_performance_log")
}

// ─────────────────────────────────────────────
// 3b. MANAGER TASKS & ANNOUNCEMENTS
// ─────────────────────────────────────────────

/**
 * A daily cold-call target task created by a PRE_SALES_MANAGER.
 * Persists until the manager edits or deletes it.
 * Replaces the old hardcoded COLD_CALL_DAILY_TARGET = 100 constant.
 */
model ManagerTask {
  id             String            @id @default(uuid())
  managerId      String
  manager        User              @relation("ManagerTaskCreator", fields: [managerId], references: [id])
  coldCallTarget Int
  isActive       Boolean           @default(true)
  assignees      ManagerTaskUser[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([managerId])
  @@index([isActive])
  @@map("manager_task")
}

/**
 * Join table between ManagerTask and the employees it is assigned to.
 * backlogOverride: when set by the manager, replaces the computed backlog for this employee.
 */
model ManagerTaskUser {
  id              String      @id @default(uuid())
  taskId          String
  task            ManagerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String
  user            User        @relation("ManagerTaskAssignee", fields: [userId], references: [id])
  backlogOverride Int? // null = use computed backlog; number = manager manually reduced it
  targetOverride  Int? // Optional manual daily target override set by manager for today
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([taskId])
  @@index([userId])
  @@map("manager_task_user")
}

/**
 * A broadcast message from a PRE_SALES_MANAGER to all their subordinates.
 * Employees see active announcements at the top of their dashboard.
 */
model Announcement {
  id          String   @id @default(uuid())
  managerId   String
  manager     User     @relation("AnnouncementCreator", fields: [managerId], references: [id])
  title       String
  description String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([managerId])
  @@index([isActive])
  @@map("announcement")
}

// ─────────────────────────────────────────────
// 4. DOMAIN 2: LEAD & CUSTOMER MANAGEMENT
// ─────────────────────────────────────────────

model LeadSource {
  id        String         @id @default(uuid())
  name      String         @unique
  type      LeadSourceType
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  leads Lead[]

  @@map("lead_source")
}

model Lead {
  id             String  @id @default(uuid())
  firstName      String
  lastName       String?
  phone          String
  alternatePhone String?
  email          String?
  avatar         String?

  sourceId    String?
  source      LeadSource?      @relation(fields: [sourceId], references: [id])
  status      LeadStatus       @default(NEW)
  subStatus   String?          @default("PENDING")
  temperature LeadTemperature?
  score       Int?             @default(0)

  interestedProjectId  String?
  interestedProject    Project? @relation(fields: [interestedProjectId], references: [id])
  interestedTowerId    String?
  interestedTower      Tower?   @relation(fields: [interestedTowerId], references: [id])
  interestedUnitId     String?
  interestedUnit       Unit?    @relation(fields: [interestedUnitId], references: [id])
  brokerId             String?
  broker               Broker?  @relation(fields: [brokerId], references: [id])
  budget               Decimal?
  preferredConfig      String?
  preferredLocation    String?
  requirements         String?
  customerSummary      String?  @db.Text
  aiNextStepSuggestion String?  @db.Text

  assignedUserId String?
  assignedUser   User?   @relation("AssignedUser", fields: [assignedUserId], references: [id])
  createdById    String?
  createdBy      User?   @relation("CreatedBy", fields: [createdById], references: [id])

  lastContactDate  DateTime?
  nextFollowUpDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assignmentHistory     LeadAssignmentHistory[]
  followUps             FollowUp[]
  callRecords           CallRecord[]
  whatsappConversations WhatsAppConversation[]
  emailConversations    EmailConversation[]
  smsConversations      SmsConversation[]
  siteVisits            SiteVisit[]
  negotiations          Negotiation[]
  notes                 Note[]                  @relation("LeadNotes")
  activities            ActivityTimeline[]      @relation("LeadActivities")
  customer              Customer?
  campaignRecipients    CampaignRecipient[]
  smsRecipients         SmsRecipient[]
  voiceRecipients       VoiceRecipient[]
  whatsappContacts      WhatsAppContact[]
  metaLeadLogs          MetaLeadWebhookLog[]    @relation("MetaLeadLog")
  googleLeadLogs        GoogleLeadWebhookLog[]  @relation("GoogleLeadLog")

  @@index([status])
  @@index([temperature])
  @@index([assignedUserId])
  @@index([sourceId])
  @@index([interestedProjectId])
  @@index([interestedTowerId])
  @@index([interestedUnitId])
  @@index([brokerId])
  @@index([nextFollowUpDate])
  @@index([createdAt])
  @@index([phone])
  @@map("lead")
}

model LeadAssignmentHistory {
  id           String   @id @default(uuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromUserId   String?
  fromUser     User?    @relation("AssignmentFrom", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User     @relation("AssignmentTo", fields: [toUserId], references: [id])
  reason       String?
  assignedById String?
  assignedBy   User?    @relation("AssignedByUser", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@index([leadId])
  @@index([toUserId])
