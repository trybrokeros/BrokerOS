model Broker {
  id                String       @id @default(uuid())
  brokerCode        String       @unique
  name              String
  companyName       String?
  phone             String
  alternatePhone    String?
  email             String?
  reraNumber        String?
  reraState         String?
  gstNumber         String?
  address           String?      @db.Text
  city              String?
  state             String?
  pincode           String?
  serviceAreas      String[]
  status            BrokerStatus @default(NEW)
  subStatus         String?      @default("PENDING")
  sourcingManagerId String?
  sourcingManager   User?        @relation("SourcingManager", fields: [sourcingManagerId], references: [id])
  profilePhotoUrl   String?
  experience        Int?
  specialization    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  documents             BrokerDocument[]
  projectAssignments    BrokerProjectAssignment[]
  meetings              BrokerMeeting[]
  referrals             BrokerReferral[]
  brokerageRecords      BrokerageRecord[]
  callRecords           CallRecord[]
  followUps             FollowUp[]
  notes                 Note[]                    @relation("BrokerNotes")
  activities            ActivityTimeline[]        @relation("BrokerActivities")
  whatsappConversations WhatsAppConversation[]
  emailConversations    EmailConversation[]
  smsConversations      SmsConversation[]
  leads                 Lead[]
  campaignRecipients    CampaignRecipient[]
  smsRecipients         SmsRecipient[]

  invoices Invoice[]

  @@index([sourcingManagerId])
  @@index([status])
  @@index([city])
