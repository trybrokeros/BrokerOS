{
  "$schema": "https://mintlify.com/docs.json",
  "name": "BrokerOS",
  "theme": "mint",
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "customCSS": "/custom.css",
  "colors": {
    "primary": "#4F46E5",
    "light": "#818CF8",
    "dark": "#3730A3"
  },
  "favicon": "/favicon.ico",
  "navbar": {
    "links": [
      {
        "label": "API Reference",
        "href": "/api-reference/overview"
      },
      {
        "label": "Support",
        "href": "https://github.com/trybrokeros/BrokerOS/discussions"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open CRM",
      "href": "https://github.com/trybrokeros/BrokerOS"
    }
  },
  "banner": {
    "content": "🚀 **BrokerOS Enterprise CRM & AI Voice Engine** — Built for serious real estate brokerage firms. [Explore Guides →](/overview/introduction)",
    "dismissible": true
  },
  "search": {
    "prompt": "Search for Leads, Campaigns, Voice Agents, Site Visits, APIs..."
  },
  "thumbnails": {
    "fonts": {
      "family": "Geist"
    }
  },
  "seo": {
    "organization": {
      "name": "BrokerOS",
      "url": "https://brokeros.com",
      "logo": "https://brokeros.mintlify.site/favicon.ico",
      "sameAs": [
        "https://github.com/trybrokeros/brokeros",
        "https://linkedin.com/company/brokeros"
      ]
    },
    "metatags": {
      "canonical": "https://brokeros.mintlify.site",
      "og:site_name": "BrokerOS Documentation",
      "og:type": "website",
      "twitter:site": "@brokeros",
      "twitter:card": "summary_large_image"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/trybrokeros/brokeros",
      "linkedin": "https://linkedin.com/company/brokeros"
    }
  },
