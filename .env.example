# =============================================================
# BrokerOS — Monorepo Root Environment Variables (.env.example)
# =============================================================
# This file is the MASTER template for heavy infrastructure.
# Copy this file to `.env` in the root directory:
#   cp .env.example .env
#
# Then fill in your real values.
# NEVER commit your real .env file.
# =============================================================

# -------------------------------------------------------------
# 1. DATABASE
# -------------------------------------------------------------
# Local Docker:  postgresql://crm:crm@localhost:5432/crm
# Cloud (Neon):  postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"

# -------------------------------------------------------------
# 2. API PUBLIC URL
# -------------------------------------------------------------
# The public-facing URL of the NestJS API.
# Used by workers to build email tracking pixels and SMS redirect links.
# Dev: http://localhost:3333
# Prod: https://api.yourdomain.com
API_PUBLIC_URL="http://localhost:3333"

# -------------------------------------------------------------
# 3. REDIS (BullMQ Workers & Job Queues)
# -------------------------------------------------------------
# Local:   redis://127.0.0.1:6379
# Upstash: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL="redis://127.0.0.1:6379"

# -------------------------------------------------------------
# 4. AUTHENTICATION (Better Auth)
# -------------------------------------------------------------
# Generate a secret: openssl rand -hex 32
# BETTER_AUTH_URL must match the API server URL exactly.
BETTER_AUTH_SECRET="your-64-char-hex-secret-here"
BETTER_AUTH_URL="http://localhost:3333"

# -------------------------------------------------------------
# 5. FILE STORAGE (Vercel Blob)
# -------------------------------------------------------------
# Get token from: https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN="your-vercel-blob-rw-token-here"

# -------------------------------------------------------------
# 6. AI INFERENCE (Groq)
# -------------------------------------------------------------
# Get key from: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"

# -------------------------------------------------------------
# 7. WHATSAPP CLOUD API
# -------------------------------------------------------------
# Required only when using WhatsApp marketing or the WhatsApp inbox.
# WA_WEBHOOK_VERIFY_TOKEN: any string you choose — must match what
#   you enter in the Meta App dashboard webhook verification field.
# WA_ENCRYPTION_KEY: 32-byte hex string for AES-256-GCM encryption.
#   Generate: openssl rand -hex 32
# WA_APP_SECRET / META_APP_SECRET: from Meta App dashboard → App Secret.
# META_APP_ID: from Meta App dashboard → App ID.
WA_WEBHOOK_VERIFY_TOKEN="your-whatsapp-webhook-verify-token"
WA_ENCRYPTION_KEY="your-32-byte-hex-key-for-aes-256-gcm"
WA_APP_SECRET="your-meta-app-secret"
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"

# -------------------------------------------------------------
# 8. GOOGLE ADS
# -------------------------------------------------------------
# Required only when using Google Ads lead ingestion.
# Get from: https://developers.google.com/google-ads/api/docs/get-started/dev-token
GOOGLE_ADS_DEVELOPER_TOKEN="your-google-ads-developer-token"
GOOGLE_ADS_CLIENT_ID="your-oauth2-client-id.apps.googleusercontent.com"
GOOGLE_ADS_CLIENT_SECRET="your-oauth2-client-secret"
# Webhook signing key — any secure random string you choose.
# Must match what you configure in the Google Ads lead form webhook settings.
GOOGLE_ADS_WEBHOOK_KEY="your-google-ads-webhook-signing-key"

# -------------------------------------------------------------
# 9. VOICE & TTS PROVIDER KEYS
# -------------------------------------------------------------
# Only needed when using AI Voice campaigns.
# Configure only the provider(s) you plan to use.

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Deepgram (STT) — https://console.deepgram.com/
DEEPGRAM_API_KEY="your-deepgram-api-key"

# Cartesia — https://cartesia.ai/
CARTESIA_API_KEY="your-cartesia-api-key"

# Sarvam AI (Indic languages) — https://www.sarvam.ai/
SARVAM_API_KEY="your-sarvam-api-key"

# Inworld AI — https://studio.inworld.ai/
INWORLD_API_KEY="your-inworld-api-key"

# MiniMax — https://www.minimaxi.com/
MINIMAX_API_KEY="your-minimax-api-key"

# Fish Audio — https://fish.audio/
FISH_AUDIO_API_KEY="your-fish-audio-api-key"

# OpenAI (Realtime API) — https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key"

# Azure Cognitive Speech — https://portal.azure.com/
AZURE_SPEECH_KEY="your-azure-speech-key"
AZURE_SPEECH_REGION="eastus"

# LMNT — https://lmnt.com/
LMNT_API_KEY="your-lmnt-api-key"

# Rime AI — https://rime.ai/
RIME_API_KEY="your-rime-api-key"

# xAI (Grok voice) — https://console.x.ai/
XAI_API_KEY="your-xai-api-key"