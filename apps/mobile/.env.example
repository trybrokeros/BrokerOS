# =============================================================
# BrokerOS — Mobile (Expo) Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# Never commit your real .env file.
# =============================================================

# ─────────────────────────────────────────────────────────────
# HOW TO FIND YOUR LOCAL MACHINE IP ADDRESS
# Your phone/emulator cannot reach "localhost" — it needs the
# actual LAN IP of the machine running the backend.
#
#   Windows (PowerShell / CMD):
#       ipconfig | findstr /i "ipv4"
#     → Prints only your IPv4 line. Example: 192.168.1.42
#   
#   Mac / Linux:
#     ifconfig | grep "inet " | grep -v 127.0.0.1
#     → The output shows your LAN IP. Example: 192.168.1.42
#
#   Android Emulator (AVD only — not a physical device):
#     Use 10.0.2.2 to reach your host machine's localhost.
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:3333
# ─────────────────────────────────────────────────────────────

# -------------------------------------------------------------
# 1. BACKEND API URL (CRITICAL)
# -------------------------------------------------------------
# Replace 192.168.x.x with your actual LAN IP found above.
# For production: https://your-api-domain.com
EXPO_PUBLIC_API_URL=http://192.168.x.x:3333

# -------------------------------------------------------------
# 2. MAPS & LOCATION (Required for Site Visits)
# -------------------------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Maps SDK for Android
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
