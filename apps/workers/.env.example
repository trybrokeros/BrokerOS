# =============================================================
# BrokerOS — Workers (Background Queue) Environment Variables
# =============================================================
# Heavy infrastructure keys (DATABASE_URL, REDIS_URL, all API
# provider credentials) are loaded from the root /.env file.
# This file is ONLY for worker-specific overrides.
#
# How env loading works (see src/main.ts):
#   1. Loads root /.env first (shared secrets & infra)
#   2. Then loads this file (workers-only overrides)
# =============================================================

# -------------------------------------------------------------
# 1. SERVER PORT
# -------------------------------------------------------------
PORT=3334

# -------------------------------------------------------------
# 2. PUBLIC API BASE URL
# -------------------------------------------------------------
# ┌─────────────────────────────────────────────────────────┐
# │  DEV:  localhost is fine. Workers run on the same       │
# │        machine as the API, so localhost resolves.       │
# │        Tracking won't work in dev — that's expected.    │
# │                                                         │
# │  PROD: Set this to your public API domain.              │
# │        Example: https://api.yourdomain.com              │
# └─────────────────────────────────────────────────────────┘
API_PUBLIC_URL="http://localhost:3333"
