{
  "name": "@brokeros/api",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "pnpm --filter @brokeros/prisma db:generate",
    "db:migrate": "pnpm --filter @brokeros/prisma db:migrate",
    "db:format": "pnpm --filter @brokeros/prisma db:format",
    "db:studio": "pnpm --filter @brokeros/prisma db:studio",
    "db:seed": "pnpm --filter @brokeros/prisma db:seed"
  },
  "dependencies": {
    "@brokeros/constants": "workspace:*",
