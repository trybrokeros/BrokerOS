# =============================================================
# BrokerOS — API (NestJS) Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# Heavy infrastructure (DATABASE_URL, REDIS_URL, Better Auth
# secrets, AI keys, 3rd-party provider credentials) are loaded
# from the root /.env file.
#
# How env loading works (see src/main.ts):
#   1. Loads root /.env first  (shared secrets & infra)
#   2. Then loads this file    (API-only routing overrides)
# =============================================================

# -------------------------------------------------------------
# 1. SERVER PORT
# -------------------------------------------------------------
PORT=3333

# -------------------------------------------------------------
# 2. CORS & BETTER AUTH TRUSTED ORIGINS
# -------------------------------------------------------------
# FRONTEND_URL and MOBILE_URL are used exclusively in
# src/lib/auth.ts as Better Auth trustedOrigins[].
# If a request comes from an origin NOT in this list,
# Better Auth will reject the session cookie.

# Frontend web app URL (Next.js dev server)
FRONTEND_URL="http://localhost:3000"

# Mobile app URL — CRITICAL: use your machine's LAN IP.
# Physical devices cannot reach "localhost" on your machine.
#
# Find your LAN IP:
#   Windows:    ipconfig | findstr /i "ipv4"
#   Mac/Linux:  ifconfig | grep "inet " | grep -v 127.0.0.1
#
# Format depends on how you run the app:
#   Custom dev client (npx expo run:android):  http://192.168.x.x:8081
#   Expo Go app:                               exp://192.168.x.x:8081
#
# The mobile app uses a custom dev client (has native auto-dialer module),
# so the http:// format is correct for most cases.
MOBILE_URL="http://192.168.x.x:8081"
