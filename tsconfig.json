{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@brokeros/prisma": ["packages/prisma/src/index.ts"],
      "@brokeros/constants": ["packages/constants/src/index.ts"],
      "@brokeros/types": ["packages/types/src/index.ts"],
      "@brokeros/int-*": ["integrations/*/src/index.ts"]
    }
  }
}
